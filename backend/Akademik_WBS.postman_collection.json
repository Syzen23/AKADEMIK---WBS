            },
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}/tasks/{{lockedTaskId}}/logs", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}", "tasks", "{{lockedTaskId}}", "logs"] }
          }
        },
        {
          "name": "Get Project All Work Logs",
          "request": {
            "method": "GET",
